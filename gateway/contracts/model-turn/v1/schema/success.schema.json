{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fastgate:model-turn:v1:success",
  "title": "FastGate model-turn v1 completed result",
  "description": "Strict non-streaming successful FastGate model-turn result shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "request_id",
    "output_text"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "v1"
    },
    "kind": {
      "type": "string",
      "const": "model_turn.completed"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
    },
    "output_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
