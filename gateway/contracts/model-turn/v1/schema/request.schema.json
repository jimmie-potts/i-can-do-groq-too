{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fastgate:model-turn:v1:request",
  "title": "FastGate model-turn v1 request",
  "description": "Strict non-streaming FastGate-owned model-turn request shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "request_id",
    "model_alias",
    "conversation",
    "repository_instructions",
    "required_capabilities"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "v1"
    },
    "kind": {
      "type": "string",
      "const": "model_turn.request"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
    },
    "model_alias": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
    },
    "conversation": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          }
        }
      }
    },
    "repository_instructions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "content"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029]+(?![\\s\\S])"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          }
        }
      }
    },
    "required_capabilities": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "tool_calls"
        ]
      }
    }
  }
}
