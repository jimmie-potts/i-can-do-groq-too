{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fastgate:model-turn:v1:failure",
  "title": "FastGate model-turn v1 failed result",
  "description": "Strict non-streaming normalized FastGate model-turn failure shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "request_id",
    "error"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "v1"
    },
    "kind": {
      "type": "string",
      "const": "model_turn.failed"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "invalid_request",
            "authentication_failed",
            "rate_limited",
            "request_rejected",
            "unsupported_capability",
            "unavailable",
            "invalid_response",
            "unsupported_upstream_output",
            "internal_error"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029]+(?![\\s\\S])"
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
